{
    "name": "@actions-rs-plus/clippy-check",
    "version": "0.0.0",
    "private": false,
    "description": "Run clippy and annotate the diff with errors and warnings",
    "keywords": [
        "actions",
        "cargo",
        "rust"
    ],
    "bugs": {
        "url": "https://github.com/actions-rs-plus/clippy-check/issues"
    },
    "license": "MIT",
    "author": "actions-rs-plus",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/actions-rs-plus/clippy-check.git"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.js.map",
        "dist/**/*.d.ts"
    ],
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "vite build && mkdir -p dist/.matchers && cp matchers/rust.json dist/.matchers/rust.json",
        "watch": "vite build --watch",
        "lint": "oxlint",
        "lint:fix": "pnpm run lint --fix",
        "format": "oxfmt",
        "clean": "rm -rf ./dist/* && rm tsconfig.tsbuildinfo && pnpm run build",
        "test": "vitest --coverage.enabled=true",
        "deps:ci": "depcruise --config dependency-cruiser.config.ts --output-type err src",
        "deps:graph": "depcruise --config dependency-cruiser.config.ts --output-type dot src | dot -T svg > dependency-graph.svg",
        "deps:report": "depcruise --config dependency-cruiser.config.ts --output-type err-html --output-to dependency-report.html src",
        "postversion": "cp package.json pnpm-lock.yaml ..",
        "prepare": "husky"
    },
    "dependencies": {
        "@actions-rs-plus/core": "0.11.0",
        "@actions/core": "3.0.1",
        "@actions/exec": "3.0.0",
        "source-map-support": "0.5.21",
        "string-argv": "0.3.2"
    },
    "devDependencies": {
        "@actions/io": "3.0.2",
        "@codecov/vite-plugin": "2.0.1",
        "@types/node": "24.13.6",
        "@types/semver": "7.8.0",
        "@types/source-map-support": "0.5.10",
        "@vitest/coverage-v8": "5.0.1",
        "@vitest/ui": "5.0.1",
        "dependency-cruiser": "18.4.0",
        "eslint-plugin-n": "18.3.0",
        "eslint-plugin-perfectionist": "5.11.1",
        "husky": "9.1.7",
        "lint-staged": "17.5.1",
        "oxfmt": "0.70.0",
        "oxlint": "1.85.0",
        "oxlint-tsgolint": "7.0.2002",
        "semver": "7.8.5",
        "typescript": "6.0.3",
        "vite": "catalog:default",
        "vite-plugin-checker": "0.14.5",
        "vitest": "5.0.1"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "oxlint --no-error-on-unmatched-pattern --",
            "depcruise --config dependency-cruiser.config.ts --include-only ^src/ --validate --"
        ],
        "*": [
            "oxfmt --check --no-error-on-unmatched-pattern --"
        ]
    },
    "engines": {
        "node": "24.21.0",
        "pnpm": "12.5.1"
    },
    "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
